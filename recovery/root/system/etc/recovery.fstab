
# recovery.fstab for Samsung Galaxy A15 5G (a15x)
# Based on vendor/mediatek/proprietary/hardware/fstab/mt6835/fstab.in.mt6835
/dev/block/by-name/system       /system       erofs    ro                                      wait,avb=vbmeta_system,first_stage_mount
/dev/block/by-name/userdata     /data         f2fs     noatime,nosuid,nodev,discard,fsync_mode=nobarrier,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized wait,formattable,latemount
/dev/block/by-name/cache        /cache        ext4     noatime,nosuid,nodev,discard            wait,formattable
/dev/block/by-name/vendor       /vendor       erofs    ro                                      wait,avb,first_stage_mount
/dev/block/by-name/product      /product      erofs    ro                                      wait,avb,first_stage_mount
/dev/block/by-name/odm          /odm          erofs    ro                                      wait,avb,first_stage_mount
/dev/block/by-name/system_dlkm  /system_dlkm  erofs    ro                                      wait,avb,first_stage_mount
/dev/block/by-name/vendor_dlkm  /vendor_dlkm  erofs    ro                                      wait,avb,first_stage_mount
/dev/block/by-name/metadata     /metadata     ext4     noatime,nosuid,nodev,discard            wait,formattable
/dev/block/by-name/dtbo         /dtbo         emmc     defaults                                defaults

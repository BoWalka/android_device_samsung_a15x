# Cleaned and commented fstab for Samsung Galaxy A15x (MTK, dynamic partitions)

# SYSTEM PARTITION (Read-only, EROFS is common for modern Samsung/MTK)
system        /system        erofs   ro   wait,logical,first_stage_mount,avb

# SYSTEM_EXT PARTITION
system_ext    /system_ext    erofs   ro   wait,logical,first_stage_mount,avb

# VENDOR PARTITION
vendor        /vendor        erofs   ro   wait,logical,first_stage_mount,avb

# PRODUCT PARTITION
product       /product       erofs   ro   wait,logical,first_stage_mount,avb

# ODM PARTITION (Optional, present on many recent devices)
odm           /odm           erofs   ro   wait,logical,first_stage_mount,avb

# VENDOR_DLKM (Driver Kernel Modules, dynamic partition)
vendor_dlkm   /vendor_dlkm   erofs   ro   wait,logical,first_stage_mount,avb

# SYSTEM_DLKM (Driver Kernel Modules, dynamic partition)
system_dlkm   /system_dlkm   erofs   ro   wait,logical,first_stage_mount,avb

# METADATA (for encryption, backup, and more)
# The block path may vary (by-name/metadata is common on Samsung/MTK)
# 'formattable' flag allows formatting from recovery
/dev/block/by-name/metadata  /metadata   ext4  noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic,sync  wait,check,formattable,first_stage_mount
